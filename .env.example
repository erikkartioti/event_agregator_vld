# Скопируйте в .env и задайте свои значения (файл .env в git не попадает)
DB_USER=events_admin
DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me-too
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
# python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change-me-long-random-string

# --- LLM-агент диагностики ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Пароль служебного пользователя Airflow с ролью Viewer (агент читает только логи и историю запусков)
DIAGNOSTICS_PASSWORD=change-me-diagnostics
# Необязательно: путь к конфигу JSON API источников внутри контейнера, например /config/sources.json
SOURCES_CONFIG=
